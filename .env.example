# ============================================================
#  Aila — variáveis de ambiente (copie para .env)
# ============================================================
# Tudo aqui tem default sensato em config/default.yaml.
# As variáveis abaixo SOBRESCREVEM o YAML (prefixo AILA_).

# --- Servidor ---
AILA_HOST=127.0.0.1
AILA_PORT=8770

# --- LLM / Ollama ---
AILA_LLM__BACKEND=ollama
AILA_LLM__BASE_URL=http://127.0.0.1:11434
AILA_LLM__MODEL=qwen2.5:7b-instruct
AILA_LLM__CODE_MODEL=deepseek-coder:6.7b

# --- Segurança ---
# read_only=true impede QUALQUER escrita/execução até você liberar.
AILA_SECURITY__READ_ONLY=true
# Confirma antes de ações destrutivas (apagar, sobrescrever, comandos shell).
AILA_SECURITY__CONFIRM_DESTRUCTIVE=true
# Raiz do sandbox: agentes de arquivo não saem daqui sem permissão explícita.
AILA_SECURITY__SANDBOX_ROOT=E:/Projetos/Projeto_Aila/workspace

# --- Logging ---
AILA_LOG_LEVEL=INFO
